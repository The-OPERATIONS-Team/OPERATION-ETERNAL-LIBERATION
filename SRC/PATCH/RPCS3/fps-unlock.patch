 LOG_CHANNEL(sys_ppu_thread);
 
+// Ace Combat Infinity: hold the native cadence while a pre-rendered movie plays.
+// The movie middleware paces its own decoding, but the game draws the subtitles
+// on the ordinary per-frame tick, so above the native frame rate they run ahead
+// of the audio. The middleware's own tick sits behind object indirection, so
+// this watches the decode thread's lifetime instead, which needs no guest
+// address and does not move between game versions.
+
+namespace aci_fmv
+{
+	std::atomic<bool> g_active{false};
+
+	// The id of the thread that set the flag, so a later same-named thread
+	// cannot clear it on behalf of one still running.
+	std::atomic<u64> g_active_tid{0};
+}
+
+bool aci_fmv_is_active()
+{
+	return aci_fmv::g_active.load(std::memory_order_relaxed);
+}
+
 // Simple structure to cleanup previous thread, because can't remove its own thread
 struct ppu_thread_cleaner
 {
@@ -84,6 +105,12 @@ void _sys_ppu_thread_exit(ppu_thread& ppu, u64 errorcode)
 
 	sys_ppu_thread.trace("_sys_ppu_thread_exit(errorcode=0x%llx)", errorcode);
 
+	if (aci_fmv::g_active_tid == ppu.id)
+	{
+		aci_fmv::g_active = false;
+		sys_ppu_thread.success("[aci_fmv] FMV decode thread exited (id=0x%x); native cadence lock released", ppu.id);
+	}
+
 	ppu_join_status old_status;
 
 	// Avoid cases where cleaning causes the destructor to be called inside IDM lock scope (for performance)
@@ -552,6 +579,13 @@ error_code _sys_ppu_thread_create(ppu_thread& ppu, vm::ptr<u64> thread_id, vm::p
 
 	sys_ppu_thread.warning("_sys_ppu_thread_create(): Thread \"%s\" created (id=0x%x, func=*0x%x, rtoc=0x%x, user-tls=0x%x)", ppu_name, tid, entry.addr, entry.rtoc, tls);
 
+	if (Emu.GetTitleID() == "NPUB31347" && ppu_name == "CriManaDecodeThread")
+	{
+		aci_fmv::g_active_tid = tid;
+		aci_fmv::g_active = true;
+		sys_ppu_thread.success("[aci_fmv] FMV decode thread detected (id=0x%x); native cadence forced", tid);
+	}
+
 	ppu.check_state();
 	*thread_id = tid;
 	return CELL_OK;
