 			u64 local_vblank_count = 0;
@@ -1039,6 +1057,19 @@ namespace rsx
 				// Get current time
 				const u64 current = get_system_time();
 
+				// Pick up a rate change here rather than only at a period boundary.
+				// The rate was previously refreshed inside the period-boundary branch
+				// alone, so a forced cadence could stay in effect indefinitely after
