 	bool is_valid_npid(const SceNpId& npid);
 	bool is_same_npid(const SceNpId& npid_1, const SceNpId& npid_2);
+
+	// The game takes the matching2 serverId from the top 16 bits of a room id, but only
+	// on the invite-accept path and only from the id carried inside the invitation. RPCN
+	// uses bare ids, so that one copy gets the serverId packed in, and anything heading
+	// back toward RPCN gets it stripped off again. Every other room id stays bare, which
+	// is what keeps the ids the game puts on its own peer-to-peer wire identical to the
+	// ones an unpatched client puts there.
+	inline u64 pack_room_server(u64 room_id, u16 server_id)
+	{
+		return (room_id & 0x0000ffffffffffffull) | (static_cast<u64>(server_id) << 48);
+	}
+	inline u64 strip_room_server(u64 room_id)
+	{
+		return room_id & 0x0000ffffffffffffull;
+	}
 }
