diff --git a/rpcs3/Emu/NP/np_handler.cpp b/rpcs3/Emu/NP/np_handler.cpp
index 6b4ada8e8..e12050b5b 100644
--- a/rpcs3/Emu/NP/np_handler.cpp
+++ b/rpcs3/Emu/NP/np_handler.cpp
@@ -1092,6 +1092,40 @@ namespace np
 		}
 	}
 
+	// An invitation carries the room id at a fixed offset, big endian, and the accepting
+	// game reads its target matching2 server out of that id's top 16 bits. RPCN hands out
+	// bare ids, so fill the field in here, on the one copy that crosses to another client.
+	// Only the invitation is rewritten: the ids the game itself holds stay bare, so its own
+	// peer-to-peer traffic still matches what an unpatched client sends.
+	void np_handler::pack_invitation_room_id(std::vector<u8>& data)
+	{
+		constexpr usz invitation_room_id_offset = 40;
+
+		if (data.size() < invitation_room_id_offset + sizeof(u64))
+			return;
+
+		u64 room_id = 0;
+		for (usz i = 0; i < sizeof(u64); i++)
+			room_id = (room_id << 8) | data[invitation_room_id_offset + i];
+
+		// Already carries a server, or is not a room id at all.
+		if (room_id != strip_room_server(room_id))
+			return;
+
+		const auto server_id = np_cache.get_room_server_id(room_id);
+		if (!server_id)
+		{
+			nph_log.warning("pack_invitation_room_id: room_id(%d) is not cached, invitation sent unchanged", room_id);
+			return;
+		}
+
+		const u64 packed = pack_room_server(room_id, *server_id);
+		for (usz i = 0; i < sizeof(u64); i++)
+			data[invitation_room_id_offset + i] = static_cast<u8>(packed >> (56 - 8 * i));
+
+		nph_log.notice("pack_invitation_room_id: room_id(%d) sent as %d for server %d", room_id, packed, *server_id);
+	}
